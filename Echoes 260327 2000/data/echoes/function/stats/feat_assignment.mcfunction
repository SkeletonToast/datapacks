$tag @a remove $(stat)_feat_1
$tag @a remove $(stat)_feat_2
$tag @a remove $(stat)_feat_3
$tag @a remove $(stat)_feat_4
$tag @a[scores={$(stat)=15..}] add $(stat)_feat_1
$tag @a[scores={$(stat)=30..}] add $(stat)_feat_2
$tag @a[scores={$(stat)=50..}] add $(stat)_feat_3
$tag @a[scores={$(stat)=70..}] add $(stat)_feat_4