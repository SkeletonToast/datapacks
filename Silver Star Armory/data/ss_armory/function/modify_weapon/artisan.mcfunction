# Twinblades
    # wooden sword
        execute as @s[scores={WeaponType=1,WeaponMaterial=1}] run \
        function ssa.dev:modify/weapon {item_name:"Wooden Twinblade", \
        attack_damage:3,attack_speed:-2.5,interaction_range:0, \
            model:advanced, \
            lore:"{text:\"Advanced Weapon\",color:gray,italic:false}, \
            {text:\"+Flurry\",color:blue,italic:false}, \
            {text:\"\"}, \
            {text:\"When in Main Hand:\",color:dark_green,italic:false}, \
            {text:\" 4 Attack Damage\",color:dark_green,italic:false}, \
            {text:\" 1.5 Attack Speed\",color:dark_green,italic:false}", \
            weapon_data:"advanced:true,weight:2", \
            disable_tool:false}
            
