$attribute @s gravity modifier add elixir.lightweight.gravity -0.$(value) add_multiplied_total
$attribute @s knockback_resistance modifier add elixir.lightweight.knockback_resistance -0.$(value) add_value
$attribute @s fall_damage_multiplier modifier add elixir.lightweight.fall_damage_multiplier -0.$(value) add_multiplied_total
$attribute @s safe_fall_distance modifier add elixir.lightweight.safe_fall_distance $(value) add_value